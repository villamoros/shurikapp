# Copy to frontend/.env.local for local development. Never commit .env.local.

# Rails API base URL, as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk — Dashboard > Configure > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Server-side only (Next.js server / route handlers). Never expose it to the browser.
CLERK_SECRET_KEY=sk_test_your_secret_key
