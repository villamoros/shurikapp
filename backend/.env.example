# Copy to backend/.env for local development (dotenv-rails loads it).
# Never commit backend/.env.

# CORS: the Next.js origin allowed to call the API.
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL (docker-compose overrides DB_HOST=db).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Clerk — Dashboard > Configure > API Keys.
# Frontend API URL, must match the `iss` claim of the session tokens.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional: PEM public key ("Show JWT public key") to verify tokens without network calls.
CLERK_JWT_KEY=
# Optional: origins allowed in the `azp` claim (defaults to FRONTEND_URL).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Production only (set them in the deploy target, not in this file):
# DATABASE_URL=postgresql://postgres.<project>:<password>@<host>.pooler.supabase.com:5432/postgres?sslmode=require
# SECRET_KEY_BASE=<bin/rails secret>
